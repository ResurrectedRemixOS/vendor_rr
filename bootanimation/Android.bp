// The boot animation itself comes from vendor/extras/themes/bootanimation, which installs
// Crimson glow as bootanimation.zip; only the dark-theme symlink stays here.
install_symlink {
    name: "bootanimation-dark.zip",
    product_specific: true,
    installed_location: "media/bootanimation-dark.zip",
    symlink_target: "bootanimation.zip",
}
