    <string name="helplines_name">Helplines</string>
    <string name="helplines_loading">"ਲੋਡ ਕੀਤਾ ਜਾ ਰਿਹਾ ਹੈ…"</string>
    <string name="helplines_empty">ਕੋਈ ਹੈਲਪਲਾਈਨ ਨਹੀਂ ਮਿਲੀ।\nਸਿਮ ਕਾਰਡ ਪਾਓ ਅਤੇ ਦੁਬਾਰਾ ਕੋਸ਼ਿਸ਼ ਕਰੋ</string>
    <string name="helplines_help">"ਮਦਦ"</string>
    <string name="helplines_help_title">These are safe to call</string>
    <string name="helplines_help_message">ਇਹਨਾਂ ਵਿੱਚੋਂ ਕੋਈ ਵੀ ਨੰਬਰ ਤੁਹਾਡੇ ਕਾਲ ਇਤਿਹਾਸ ਵਿੱਚ ਨਹੀਂ ਹੈ।\nਵਧੇਰੇ ਜਾਣਕਾਰੀ ਲਈ ਕਿਸੇ ਵੀ ਆਈਟਮ ’ਤੇ ਟੈਪ ਕਰ ਸਕਦੇ ਹੋ</string>
    <string name="helplines_help_more_message">ਹੈਲਪਲਾਈਨਾਂ ਦੀ ਸੂਚੀ ਯੋਗਦਾਨੀਆਂ ਵੱਲੋਂ ਹੱਥੀਂ ਅੱਪਡੇਟ ਕੀਤੀ ਜਾਣਕਾਰੀ ਨਾਲ ਭਰੀ ਜਾਂਦੀ ਹੈ। ਜੇ ਤੁਹਾਨੂੰ ਕੋਈ ਗੁੰਮ ਜਾਂ ਗਲਤ ਜਾਣਕਾਰੀ ਮਿਲੇ, ਤਾਂ ਕਿਰਪਾ ਕਰਕੇ ਸਾਨੂੰ <xliff:g id="helplines_contact_url" example="www.lineageos.org">%1$s</xliff:g> ’ਤੇ ਸੰਪਰਕ ਕਰੋ</string>
