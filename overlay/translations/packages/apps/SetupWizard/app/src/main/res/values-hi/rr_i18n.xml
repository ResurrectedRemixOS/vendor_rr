    <string name="services_pp_explanation">ये सेवाएं आपके डिवाइस की क्षमताएं बढ़ाने के लिए काम करती हैं। डेटा का इस्तेमाल <xliff:g id="name" example="LineageOS">%1$s</xliff:g> की गोपनीयता नीति के अनुसार किया जाएगा।</string>
    <string name="services_find_privacy_policy">गोपनीयता नीति किसी दूसरे डिवाइस पर इस पते पर जाकर पढ़ सकते हैं:</string>
    <string name="services_help_improve_cm"><xliff:g id="name" example="LineageOS">%s</xliff:g> को बेहतर बनाने में मदद करें</string>
    <string name="services_metrics_label"><xliff:g id="name" example="Help improve LineageOS">%1$s</xliff:g> डायग्नोस्टिक और उपयोग का डेटा अपने-आप <xliff:g id="name" example="LineageOS">%2$s</xliff:g> को भेजकर मदद करता है। इस जानकारी से आपकी पहचान नहीं की जा सकती, और यह बैटरी लाइफ़, ऐप परफ़ॉर्मेंस और नई <xliff:g id="name" example="LineageOS">%3$s</xliff:g> सुविधाओं जैसे कामों पर काम कर रही टीमों की मदद करती है।</string>
