    <string name="trust_feature_selinux">SELinux</string>
    <string name="trust_feature_selinux_value_enforcing">"Håndhevende"</string>
    <string name="trust_feature_selinux_value_disabled">"Slått av"</string>
    <string name="trust_feature_selinux_explain">SELinux bestemmer hvilke prosesser som har tilgang til hvilke filer og stier på enheten din.\nDette hindrer apper og tjenester i å få tilgang til filer de ikke skal ha tilgang til. På den måten begrenses en eventuell skadelig prosess, og sikkerheten din bevares.</string>
    <string name="trust_feature_security_patches">Sikkerhetsoppdateringer for Android</string>
    <string name="trust_feature_security_patches_value_base">Plattform: %1$s\nLeverandør: %2$s</string>
    <string name="trust_feature_security_patches_value_new">Oppdatert</string>
    <string name="trust_feature_security_patches_value_medium">Noen måneder gammel</string>
    <string name="trust_feature_security_patches_value_old">Utdatert</string>
    <string name="trust_feature_security_patches_explain">Google gir ut sikkerhetsoppdateringer månedlig i samarbeid med leverandører av SoC-brikker for å rette feil som kan utnyttes av skadelige apper til å omgå sikkerhetsbegrensninger og forårsake varig skade på enheten. Oppdateringer som Google tilbyr, installeres hver måned på alle støttede enheter, men oppdateringer til proprietær kode kan bare installeres av produsenten av enheten din. For å holde enheten trygg, sørg for at LineageOS-versjonen din alltid er oppdatert, og (hvis aktuelt) at leverandørbildet ditt er oppdatert til den nyeste versjonen som LineageOS anbefaler.</string>
    <string name="trust_feature_encryption">"Kryptering"</string>
    <string name="trust_feature_encryption_value_enabled">"Slått på"</string>
    <string name="trust_feature_encryption_value_nolock">Krever en sikker låseskjerm</string>
    <string name="trust_feature_encryption_value_disabled">"Slått av"</string>
    <string name="trust_feature_encryption_explain">Kryptering av enheten hindrer tilgang til dataene dine når telefonen ikke har startet Android. Dette er særlig viktig hvis telefonen blir stjålet, siden det hindrer andre i å lese meldingene, kontaktene og annen privat informasjon uten passordet ditt.\nFor å gjøre krypteringen mer effektiv må du angi et sikkert passord for låseskjermen.</string>
