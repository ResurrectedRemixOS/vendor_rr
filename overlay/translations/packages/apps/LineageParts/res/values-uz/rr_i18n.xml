    <string name="trust_feature_selinux">SELinux</string>
    <string name="trust_feature_selinux_value_enforcing">"Majburan"</string>
    <string name="trust_feature_selinux_value_disabled">"Oʻchiq"</string>
    <string name="trust_feature_selinux_explain">SELinux qurilmangizdagi qaysi jarayonlar qaysi fayl va yo‘llarga kirishi mumkinligini belgilaydi.\nBu ilova va xizmatlarning ularga tegishli bo‘lmagan fayllarga kirishini oldini oladi: shunday qilib, zararli jarayonlar cheklanadi va xavfsizligingiz saqlanadi.</string>
    <string name="trust_feature_security_patches">Android xavfsizlik yangilanishlari</string>
    <string name="trust_feature_security_patches_value_base">Platforma: %1$s\nSotuvchi: %2$s</string>
    <string name="trust_feature_security_patches_value_new">Yangilangan</string>
    <string name="trust_feature_security_patches_value_medium">Bir necha oy eskirgan</string>
    <string name="trust_feature_security_patches_value_old">Eskirgan</string>
    <string name="trust_feature_security_patches_explain">Xavfsizlik yamalari Google tomonidan har oyda SoC ishlab chiqaruvchilari bilan hamkorlikda chiqariladi. Ular zararli ilovalar xavfsizlik cheklovlarini chetlab o‘tib, qurilmangizga doimiy zarar yetkazishi mumkin bo‘lgan nuqsonlarni bartaraf etadi. Google taqdim etgan yamalar barcha qo‘llab-quvvatlanadigan qurilmalarda har oy o‘rnatiladi, ammo xususiy kodga yamalarni faqat qurilma ishlab chiqaruvchisi o‘rnatishi mumkin. Qurilmangizni xavfsiz saqlash uchun LineageOS versiyangiz doim yangi bo‘lishiga ishonch hosil qiling va (agar mavjud bo‘lsa) vendor tasvirini LineageOS tavsiya etgan eng so‘nggi versiyaga yangilang.</string>
    <string name="trust_feature_encryption">"Shifrlash"</string>
    <string name="trust_feature_encryption_value_enabled">"Yoniq"</string>
    <string name="trust_feature_encryption_value_nolock">Xavfsiz ekran qulfi talab qilinadi</string>
    <string name="trust_feature_encryption_value_disabled">"Oʻchiq"</string>
    <string name="trust_feature_encryption_explain">Qurilmangizni shifrlash telefon Android’da yuklanmagan holatda ma’lumotlaringizga kirishni to‘sadi. Bu telefon o‘g‘irlanganda ayniqsa muhim, chunki parolingizsiz xabarlar, kontaktlar va boshqa shaxsiy ma’lumotlarni o‘qishning oldini oladi.\nShifrlashni samaraliroq qilish uchun xavfsiz ekran qulfi parolini o‘rnatishingiz kerak.</string>
    <string name="trust_category_tools">"Maxfiylik"</string>
    <string name="trust_notification_alerts_title">Xavfsizlik ogohlantirishlari</string>
    <string name="trust_warnings_alerts_intro">Qaysi xavfsizlik muammolari haqida ogohlantirilishini tanlashingiz mumkin. Xavfsizligingiz uchun barcha ogohlantirishlarni yoqish tavsiya etiladi</string>
    <string name="trust_warnings_selinux">"SELinux holati"</string>
    <string name="trust_warnings_keys">Yig‘ish imzosi</string>
    <string name="trust_onboarding_title">Trust bilan tanishing</string>
    <string name="trust_onboarding_description">Trust qurilmangizni xavfsiz saqlashga va shaxsiy ma’lumotlaringizni himoya qilishga yordam beradi.\nTrust belgisi faqat sahifa mazmuni tasdiqlangandan so‘ng ko‘rinadi.</string>
    <string name="trust_onboarding_learn_more">"Batafsil"</string>
    <string name="trust_onboarding_done">"OK"</string>
    <string name="trust_restrict_usb_title">USB ni cheklash</string>
