    <string name="trust_category_features">"Hali"</string>
    <string name="trust_feature_selinux">SELinux</string>
    <string name="trust_feature_selinux_value_enforcing">"Inatekeleza"</string>
    <string name="trust_feature_selinux_value_disabled">"Imezimwa"</string>
    <string name="trust_feature_selinux_explain">SELinux huamua ni michakato ipi inaweza kufikia faili/njia zipi kwenye kifaa chako.\nHii huzuia programu na huduma kufikia faili ambazo hazipaswi kufikia: kwa njia hii mchakato hasidi unaowezekana unadhibitiwa na usalama wako unahifadhiwa.</string>
    <string name="trust_feature_security_patches">Viraka vya usalama vya Android</string>
    <string name="trust_feature_security_patches_value_base">Jukwaa: %1$s\nMuuzaji: %2$s</string>
    <string name="trust_feature_security_patches_value_new">Umesasishwa</string>
    <string name="trust_feature_security_patches_value_medium">Vimepitwa na wakati kwa miezi michache</string>
    <string name="trust_feature_security_patches_value_old">Vimepitwa na wakati</string>
    <string name="trust_feature_security_patches_explain">Mabaka ya usalama hutolewa kila mwezi na Google kwa ushirikiano na watengenezaji wa SoC ili kurekebisha hitilafu zinazoweza kutumiwa na programu hasidi kukwepa vizuizi vya usalama na kusababisha uharibifu wa kudumu kwenye kifaa chako. Mabaka yanayotolewa na Google husakinishwa kila mwezi kwenye vifaa vyote vinavyoungwa mkono, lakini mabaka ya msimbo wa umiliki yanaweza kusakinishwa tu na mtengenezaji wa kifaa chako. Ili kuweka kifaa chako salama, hakikisha LineageOS yako daima ni ya toleo la hivi karibuni, na (ikiwa inatumika) hakikisha picha ya muuzaji wako imesasishwa hadi toleo la hivi karibuni linalopendekezwa na LineageOS.</string>
    <string name="trust_feature_encryption">"Usimbaji fiche"</string>
    <string name="trust_feature_encryption_value_enabled">"Imewashwa"</string>
    <string name="trust_feature_encryption_value_nolock">Inahitaji skrini iliyofungwa salama</string>
    <string name="trust_feature_encryption_value_disabled">"Imezimwa"</string>
    <string name="trust_feature_encryption_explain">Kusimba kifaa chako kwa njia fiche huzuia ufikiaji wa data yako wakati simu haijaanzishwa kwenye Android. Hii ni muhimu hasa simu yako ikiibiwa, kwa kuwa inazuia watu kusoma ujumbe, anwani na taarifa zako nyingine binafsi bila nenosiri lako.\nIli usimbaji fiche uwe na ufanisi zaidi, unahitaji kuweka nenosiri salama la skrini iliyofungwa.</string>
    <string name="trust_category_tools">"Faragha"</string>
    <string name="trust_notification_alerts_title">Tahadhari za usalama</string>
    <string name="trust_warnings_alerts_intro">Unaweza kuchagua matatizo ya usalama unayotaka kuonywa kuyahusu. Kwa usalama wako, inapendekezwa kuwasha tahadhari zote</string>
    <string name="trust_warnings_selinux">"Hali ya SELinux"</string>
    <string name="trust_warnings_keys">Sahihi ya muundo</string>
    <string name="trust_onboarding_title">Karibu kwenye Trust</string>
