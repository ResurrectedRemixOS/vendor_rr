    <string name="trust_feature_selinux_value_enforcing">"نافذ کر رہا ہے"</string>
    <string name="trust_feature_selinux_value_disabled">"غیر فعال"</string>
    <string name="trust_feature_selinux_explain">SELinux طے کرتا ہے کہ کون سے پروسیسز آپ کے آلے پر کن فائلوں یا راستوں تک رسائی رکھ سکتے ہیں۔\nاس سے ایپس اور سروسز ایسی فائلوں تک رسائی نہیں پاتیں جن تک انہیں نہیں ہونا چاہیے: اس طرح کسی ممکنہ مضر پروسیس کو محدود رکھا جاتا ہے اور آپ کی سیکیورٹی برقرار رہتی ہے۔</string>
    <string name="trust_feature_security_patches">Android سیکیورٹی پیچز</string>
    <string name="trust_feature_security_patches_value_base">پلیٹ فارم: %1$s\nوینڈر: %2$s</string>
    <string name="trust_feature_security_patches_value_new">تازہ ترین</string>
    <string name="trust_feature_security_patches_value_medium">چند ماہ پرانا</string>
    <string name="trust_feature_security_patches_value_old">پرانا ہو چکا ہے</string>
    <string name="trust_feature_security_patches_explain">Google ہر ماہ SoC وینڈرز کے تعاون سے سیکیورٹی پیچز جاری کرتا ہے تاکہ ایسی خامیوں کو دور کیا جا سکے جنہیں مضر ایپس سیکیورٹی پابندیاں توڑنے اور آلے کو مستقل نقصان پہنچانے کے لیے استعمال کر سکتی ہیں۔ Google کے جاری کردہ پیچز ہر ماہ تمام معاون آلات پر لاگو کیے جاتے ہیں، لیکن ملکیتی کوڈ کے پیچز صرف آپ کے آلے کا مینوفیکچرر ہی لاگو کر سکتا ہے۔ اپنے آلے کو محفوظ رکھنے کے لیے یقینی بنائیں کہ آپ کا LineageOS بلڈ ہمیشہ اپ ٹو ڈیٹ ہو، اور (اگر لاگو ہو) یقینی بنائیں کہ آپ کا وینڈر امیج LineageOS کی تجویز کردہ تازہ ترین نسخے پر اپ ڈیٹ ہو۔</string>
    <string name="trust_feature_encryption">"مرموز کاری"</string>
    <string name="trust_feature_encryption_value_enabled">"فعال"</string>
    <string name="trust_feature_encryption_value_nolock">محفوظ لاک اسکرین درکار ہے</string>
    <string name="trust_feature_encryption_value_disabled">"غیر فعال"</string>
    <string name="trust_feature_encryption_explain">آلے کو انکرپٹ کرنے سے جب فون Android میں بوٹ نہ ہو تو آپ کے ڈیٹا تک رسائی روک دی جاتی ہے۔ یہ خاص طور پر اس وقت اہم ہے جب فون چوری ہو جائے، کیونکہ اس سے لوگ آپ کے پاسورڈ کے بغیر آپ کے پیغامات، رابطے اور دیگر نجی معلومات نہیں پڑھ سکتے۔\nانکرپشن کو مؤثر بنانے کے لیے آپ کو ایک محفوظ لاک اسکرین پاسورڈ سیٹ کرنا ہوگا۔</string>
