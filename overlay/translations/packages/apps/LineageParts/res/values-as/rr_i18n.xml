    <string name="trust_feature_selinux">SELinux</string>
    <string name="trust_feature_selinux_value_enforcing">"কাৰ্যকৰী কৰা হৈছে"</string>
    <string name="trust_feature_selinux_value_disabled">"অক্ষম কৰা আছে"</string>
    <string name="trust_feature_selinux_explain">SELinux-এ নিৰ্ধাৰণ কৰে কোন প্ৰক্ৰিয়াৰ আপোনাৰ ডিভাইচৰ কোন ফাইল/পথ ব্যৱহাৰ কৰাৰ অনুমতি আছে।\nইয়ে এপ আৰু সেৱাসমূহক সিহ�তে ব্যৱহাৰ কৰাৰ কথা নহয় এনে ফাইল ব্যৱহাৰ কৰাত বাধা দিয়ে: এইদৰে সম্ভাৱ্য ক্ষতিকাৰক প্ৰক্ৰিয়া সীমিত হয় আৰু আপোনাৰ সুৰক্ষা বজাই থাকে।</string>
    <string name="trust_feature_security_patches">Android সুৰক্ষা প্যাচ</string>
    <string name="trust_feature_security_patches_value_base">প্লেটফৰ্ম: %1$s\nভেণ্ডৰ: %2$s</string>
    <string name="trust_feature_security_patches_value_new">আপ-টু-ডেট</string>
    <string name="trust_feature_security_patches_value_medium">কেইমাহমান পুৰণি</string>
    <string name="trust_feature_security_patches_value_old">পুৰণি হৈ গৈছে</string>
    <string name="trust_feature_security_patches_explain">মাহে মাহে Google এ SoC নিৰ্মাতাৰ সৈতে সহযোগিতাত সুৰক্ষা আপডেট প্ৰকাশ কৰে, যাতে ক্ষতিকাৰক এপে সুৰক্ষা সীমাবদ্ধতা অতিক্ৰম কৰি আপোনাৰ ডিভাইচৰ স্থায়ী ক্ষতি কৰিব নোৱাৰে। Google ৰ আপডেটসমূহ সকলো সমৰ্থিত ডিভাইচত প্ৰতিমাহে প্ৰয়োগ কৰা হয়, কিন্তু স্বকীয় (proprietary) ​​ক’ডৰ আপডেট কেৱল ডিভাইচ নিৰ্মাতাই প্ৰয়োগ কৰিব পাৰে। আপোনাৰ ডিভাইচ সুৰক্ষিত ৰাখিবলৈ, আপোনাৰ LineageOS বিল্ড সদায় আপডেট ৰাখক, আৰু (প্ৰযোজ্য হ’লে) LineageOS ৰ দ্বাৰা সুপাৰিছ কৰা শেহতীয়া ভেণ্ড’ৰ ইমেজ আপডেট কৰক।</string>
    <string name="trust_feature_encryption">"এনক্ৰিপশ্বন"</string>
    <string name="trust_feature_encryption_value_enabled">"সক্ষম কৰা আছে"</string>
    <string name="trust_feature_encryption_value_nolock">সুৰক্ষিত লক স্ক্ৰীনৰ প্ৰয়োজন</string>
    <string name="trust_feature_encryption_value_disabled">"অক্ষম কৰা আছে"</string>
    <string name="trust_feature_encryption_explain">আপোনাৰ ডিভাইচ এন্ক্ৰিপ্ট কৰিলে, ফ’নটো Android ত বুট নোহোৱালৈকে আপোনাৰ তথ্যলৈ প্ৰৱেশ বন্ধ হয়। ফ’নটো চুৰি হ’লে এইটো বিশেষভাৱে গুৰুত্বপূৰ্ণ, কাৰণ ই আপোনাৰ পাছৱৰ্ড নোহোৱাকৈ বাৰ্তা, সম্পৰ্ক আৰু অন্যান্য ব্যক্তিগত তথ্য পঢ়াত বাধা দিয়ে।\nএন্ক্ৰিপশ্বন অধিক কাৰ্যকৰী কৰিবলৈ, এটা সুৰক্ষিত লক স্ক্ৰীন পাছৱৰ্ড সেট কৰক।</string>
