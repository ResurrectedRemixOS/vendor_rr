    <string name="trust_feature_selinux">SELinux</string>
    <string name="trust_feature_selinux_value_enforcing">"Pas toe"</string>
    <string name="trust_feature_selinux_value_disabled">"Gedeaktiveer"</string>
    <string name="trust_feature_selinux_explain">SELinux bepaal watter prosesse toegang tot watter lêers/paaie op jou toestel het.\nDit verhoed dat programme en dienste lêers bereik wat hulle nie mag gebruik nie: so word \'n moontlike kwaadwillige proses beperk, en jou sekuriteit bewaar.</string>
    <string name="trust_feature_security_patches">Android-sekuriteitspatches</string>
    <string name="trust_feature_security_patches_value_base">Platform: %1$s\nVerskaffer: %2$s</string>
    <string name="trust_feature_security_patches_value_new">Op datum</string>
    <string name="trust_feature_security_patches_value_medium">\'n Paar maande verouderd</string>
    <string name="trust_feature_security_patches_value_old">Verouderd</string>
    <string name="trust_feature_security_patches_explain">Sekuriteitspatches word maandeliks deur Google in samewerking met SoC-verskaffers vrygestel om foute reg te stel wat kwaadwillige programme kan uitbuit om sekuriteitsbeperkings te omseil en permanente skade aan jou toestel te veroorsaak. Patches wat deur Google beskikbaar gestel word, word elke maand op alle ondersteunde toestelle toegepas, maar patches vir eiengemaakte kode kan slegs deur jou toestel se vervaardiger toegepas word. Om jou toestel veilig te hou, maak seker jou LineageOS-bou is altyd op datum, en (indien van toepassing) dat jou verskaffersbeeld na die nuutste een opgedateer is wat deur LineageOS aanbeveel word.</string>
    <string name="trust_feature_encryption">"Enkripsie"</string>
    <string name="trust_feature_encryption_value_enabled">"Geaktiveer"</string>
    <string name="trust_feature_encryption_value_nolock">Vereis \'n veilige sluitskerm</string>
    <string name="trust_feature_encryption_value_disabled">"Gedeaktiveer"</string>
    <string name="trust_feature_encryption_explain">Enkripsie van jou toestel voorkom toegang tot jou data wanneer jou foon nie na Android opstart nie. Dit is veral belangrik as jou foon gesteel word, want dit verhoed dat mense jou boodskappe, kontakte en ander private inligting sonder jou wagwoord kan lees.\nOm die enkripsie doeltreffender te maak, moet jy \'n veilige sluitskermwagwoord instel.</string>
    <string name="trust_category_tools">"Privaatheid"</string>
    <string name="trust_notification_alerts_title">Sekuriteitswaarskuwings</string>
    <string name="trust_warnings_alerts_intro">Jy kan die sekuriteitskwessies kies waaroor jy gewaarsku wil word. Vir jou veiligheid word aanbeveel dat alle waarskuwings geaktiveer word</string>
    <string name="trust_warnings_selinux">"SELinux-status"</string>
    <string name="trust_warnings_keys">Bou-handtekening</string>
    <string name="trust_onboarding_title">Maak kennis met Trust</string>
    <string name="trust_onboarding_description">Trust help jou om jou toestel veilig te hou en jou privaatheid te beskerm.\nDie Trust-ikoon sal slegs wys wanneer die inhoud van die bladsy geverifieer is.</string>
    <string name="trust_onboarding_learn_more">"Kom meer te wete"</string>
