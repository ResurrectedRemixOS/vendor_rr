    <string name="trust_notification_alerts_title">பாதுகாப்பு எச்சரிக்கைகள்</string>
    <string name="trust_warnings_alerts_intro">நீங்கள் எச்சரிக்கப்பட விரும்பும் பாதுகாப்புச் சிக்கல்களைத் தேர்ந்தெடுக்கலாம். உங்கள் பாதுகாப்பிற்காக, எல்லா எச்சரிக்கைகளையும் இயக்குவது பரிந்துரைக்கப்படுகிறது</string>
